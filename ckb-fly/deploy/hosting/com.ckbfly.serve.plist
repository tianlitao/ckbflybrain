<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The fly's indexer as a launchd service on macOS — the self-hosting case, where the machine
  is already yours and a tunnel in front of it is the whole deployment.

      cp deploy/hosting/com.ckbfly.serve.plist ~/Library/LaunchAgents/
      # edit the two paths below, then:
      launchctl load ~/Library/LaunchAgents/com.ckbfly.serve.plist
      tail -f /tmp/ckbfly-serve.log

  Replace `REPLACE_WITH_YOUR_USER` and the project path. launchd does not expand `~`, and it
  will not start at all if a path in here is wrong — check `launchctl list | grep ckbfly` and
  the error file rather than assuming the log is empty because nothing happened.

  Note that `serve-public.sh` changes directory to its own location, so the path in
  `ProgramArguments` is what decides the working directory, and therefore which deployment
  record is read. That is deliberate: `FLY_STATE` is resolved against the current directory.

  `INDEXER_ALLOW_DRIVE` is absent on purpose. It exposes `POST /api/act`, which signs with a
  key, and nothing in this server rate-limits anything — see docs/hosting.md and the bottom of
  hosting/ckbfly-serve.service. Visitors drive the organism with their own wallets through
  `/api/prepare`, which signs nothing.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ckbfly.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/REPLACE_WITH_YOUR_USER/ckb-fly/deploy/serve-public.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CKB_RPC_URL</key>
    <string>https://testnet.ckb.dev/</string>
    <key>PORT</key>
    <string>8899</string>
    <key>INDEXER_POLL_MS</key>
    <string>3000</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!--
    The index lives in memory and every restart re-walks the chain from the head, so a crash
    loop is expensive rather than harmless. launchd's default throttle is 10 seconds; this
    makes it a minute, so a restart loop is visible in the log instead of filling it.
  -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/tmp/ckbfly-serve.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ckbfly-serve.err</string>
</dict>
</plist>
