# The fly's indexer, as a systemd service on a Linux host.
#
#     sudo useradd --system --home /nonexistent --shell /usr/sbin/nologin ckbfly
#     sudo mkdir -p /srv && sudo cp -r ckb-fly /srv/
#     sudo cp /srv/ckb-fly/deploy/hosting/ckbfly-serve.service /etc/systemd/system/
#     sudo systemctl enable --now ckbfly-serve
#     journalctl -u ckbfly-serve -f
#
# Read `docs/hosting.md` first. The short version of what this unit assumes:
#
#   * The page is served from the same origin as the API, so a tunnel or reverse proxy goes
#     in front. Nothing here listens on anything but loopback.
#   * No key is present, and none is wanted. The service user's home does not exist.
#   * `INDEXER_ALLOW_DRIVE` is deliberately absent. See the bottom of this file.

[Unit]
Description=CKB Fly indexer (public: index and prepare, signs nothing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ckbfly
Group=ckbfly
WorkingDirectory=/srv/ckb-fly/deploy

Environment=CKB_RPC_URL=https://testnet.ckb.dev/
Environment=PORT=8899
Environment=INDEXER_POLL_MS=3000
# INDEXER_ALLOW_DRIVE is absent on purpose — see the note at the bottom.

# `serve-public.sh` checks the two build products that are not in git, refuses a loopback or
# missing RPC, and refuses to expose /api/act. All of that would otherwise be a README step
# that gets skipped.
ExecStart=/srv/ckb-fly/deploy/serve-public.sh

Restart=always
RestartSec=5

# The index lives in memory and every restart re-walks the chain from the head, so a restart
# loop is expensive rather than harmless. This is a floor that stops it becoming a hot loop,
# not a fix: if it is being hit, the RPC is the problem, and `get_transaction` is the first
# thing to look at.
StartLimitIntervalSec=300
StartLimitBurst=5

# The process only reads: the deployment record, the circuit table, the bundle. It writes
# nothing, because the record is only rewritten on the server-signed path and that path is
# off. Hardening is therefore free here — but if you ever turn INDEXER_ALLOW_DRIVE on, this
# is the line that will break first, and the symptom will be a write failure with the money
# already spent.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

# ---------------------------------------------------------------------------------------
# Why INDEXER_ALLOW_DRIVE is not here.
#
# It exposes `POST /api/act`, which signs with the server's key. Nothing in this server
# rate-limits anything — no per-IP limit, no cap on actions per minute. The two ways that
# gets spent:
#
#   * `feed` drains the operator. Each click moves 1 CKB of your money into the organism's
#     body, where the type script forbids ever removing it. Anyone who finds the page can do
#     that as fast as they can click, and it is gone.
#   * `tick` pays you, but it spends the organism's life, so strangers can run it to death.
#
# With it off the page is still fully usable: a visitor who connects a wallet gets enabled
# buttons, and their click goes to `/api/prepare`, which signs nothing and spends nothing of
# yours. That is the intended public configuration.
